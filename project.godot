; Engine configuration file.
config_version=5

[application]
config/name="초증강 엘리아스 마블"
config/version="0.9.0"
config/icon="res://web/icon.png"
boot_splash/bg_color=Color(0.0784, 0.0941, 0.1412, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.3")
run/main_scene="res://scenes/start_menu.tscn"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[gui]

theme/custom_font="res://assets/fonts/game_ui_font.tres"

[debug]
gdscript/warnings/untyped_declaration=1

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/default_filters/anisotropic_filtering_level=3

environment/defaults/default_clear_color=Color(0.051, 0.063, 0.094, 1)
